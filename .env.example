# --- Supabase (required) ---
# Found in: Supabase dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Found in: Supabase dashboard → Project Settings → API → anon / public key
# Use ONLY the anon/public key here — never the service_role key on the frontend
VITE_SUPABASE_ANON_KEY=

# --- Upstash Redis (required for Edge Function rate limiting) ---
# Create a free Redis database at https://console.upstash.com
# Copy the REST URL and REST Token from the database details page.
UPSTASH_REDIS_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_TOKEN=

# --- Google Maps ---
# Frontend (autocomplete, map display) — restrict to your domain in Google Cloud Console
VITE_GOOGLE_MAPS_KEY=

# Backend — Edge Function estimate-delivery (Distance Matrix API + trafic temps réel)
# À déployer comme secret Supabase : npx supabase secrets set GOOGLE_MAPS_API_KEY=<ta_clé>
# Activer Distance Matrix API dans Google Cloud Console (peut être la même clé, restriction par IP)
# GOOGLE_MAPS_API_KEY=

# --- YouCan Pay (paiement carte) ---
# Compte à créer sur https://youcanpay.com — clés dans Réglages > Clés API
# Frontend : clé PUBLIQUE uniquement (jamais la clé privée ici)
VITE_YOUCANPAY_PUBLIC_KEY=
# 'true' tant que tu utilises tes clés pub_sandbox_/pri_sandbox_, 'false' en production
VITE_YOUCANPAY_SANDBOX=true

# Backend — Edge Functions create-payment-token et youcanpay-webhook (secrets Supabase, jamais dans .env frontend) :
#   npx supabase secrets set YOUCANPAY_PRIVATE_KEY=<ta_clé_privée>
#   npx supabase secrets set YOUCANPAY_WEBHOOK_SECRET=<génère une valeur aléatoire toi-même>
#   npx supabase secrets set SITE_ORIGIN=https://diatable.vercel.app
# Puis, dans le dashboard YouCan Pay, enregistre l'URL de webhook :
#   https://<project-ref>.supabase.co/functions/v1/youcanpay-webhook?secret=<la_même_valeur_que_ci-dessus>
# YOUCANPAY_PRIVATE_KEY=
# YOUCANPAY_WEBHOOK_SECRET=
# SITE_ORIGIN=


