# --- Supabase (required) ---
# Found in: Supabase dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Found in: Supabase dashboard → Project Settings → API → anon / public key
# Use ONLY the anon/public key here — never the service_role key on the frontend
VITE_SUPABASE_ANON_KEY=

# --- Upstash Redis (required for Edge Function rate limiting) ---
# Create a free Redis database at https://console.upstash.com
# Copy the REST URL and REST Token from the database details page.
UPSTASH_REDIS_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_TOKEN=

# --- Sentry (optional — error monitoring) ---
# Create a project at https://sentry.io, then paste its DSN below.
# Leave empty to disable error monitoring entirely (safe no-op).
VITE_SENTRY_DSN=https://b7b42e99fc93e18527de1ba9f36a09ba@o4511778656813056.ingest.de.sentry.io/4511778665398352

# --- Google Maps ---
# Frontend (autocomplete, map display) — restrict to your domain in Google Cloud Console
VITE_GOOGLE_MAPS_KEY=

# Backend — Edge Function estimate-delivery (Distance Matrix API + trafic temps réel)
# À déployer comme secret Supabase : npx supabase secrets set GOOGLE_MAPS_API_KEY=<ta_clé>
# Activer Distance Matrix API dans Google Cloud Console (peut être la même clé, restriction par IP)
# GOOGLE_MAPS_API_KEY=
